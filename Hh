        const todayTime = startOfToday.getTime();

        seasonReports.forEach(r => {
            const time = r.timestamp?.seconds ? r.timestamp.seconds * 1000 : new Date(r.timestamp).getTime();
            counts[r.diseaseId] = (counts[r.diseaseId] || 0) + 1;
            if (time >= todayTime) {
                newTodayCounts[r.diseaseId] = (newTodayCounts[r.diseaseId] || 0) + 1;
