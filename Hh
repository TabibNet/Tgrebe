        if (adInterval) { clearTimeout(adInterval); clearInterval(adInterval); adInterval = null; }

        const isSingleAd = activeAds.length === 1;

        if (ad.type === 'image') {
            mediaHTML = `<a href="${ad.link || '#'}" target="_blank" class="block w-full h-full">
                <img src="${ad.content}" alt="إعلان" class="w-full h-full object-cover transition-opacity duration-500">
