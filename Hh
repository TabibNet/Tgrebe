                async function fetchMedRequests() {
            const container = document.getElementById('requestsContainer'); 
            if (!container) return; 
            container.innerHTML = '<p class="text-center py-10" style="color: var(--muted)">جاري تحميل الطلبات...</p>';
            
            try {
                const snapshot = await getDocs(q); 
                if (snapshot.empty) { 
                    container.innerHTML = '<p class="text-center py-10" style="color: var(--muted)">لا توجد طلبات أدوية حالياً.</p>'; 
                    return; 
                } 
                let html = ''; 
                snapshot.forEach(doc => { 
                    const req = doc.data(); 
                    const date = new Date(req.createdAt).toLocaleString('ar-EG', { date: 'short', time: 'short' }); 
                    const phone = req.patientPhone; 
                    
                    let requestStatus = ''; 
                    if (req.status === 'available') requestStatus = `<span class="text-xs px-2 py-1 rounded bg-green-100 text-green-700 inline-block mb-2">تم التوفير</span>`; 
                    else if (req.status === 'unavailable') requestStatus = `<span class="text-xs px-2 py-1 rounded bg-gray-100 text-gray-700 inline-block mb-2">غير متوفر</span>`; 
                    else requestStatus = `<span class="text-xs px-2 py-1 rounded bg-yellow-100 text-yellow-700 inline-block mb-2">قيد البحث</span>`;

                    let interactionArea = '';
                    if (req.status === 'available') {
                        if (req.availablePharmacy === pharm.name) {
                            interactionArea = `
                                <div class="bg-green-50 text-green-700 text-sm font-bold p-3 rounded-lg text-center mb-2 flex items-center justify-center gap-2">
                                    <i class="fas fa-check-circle"></i> أنت من وفر هذا الدواء للمريض
                                </div>
                                <a href="tel:${phone}" class="flex-1 bg-blue-500 text-white px-3 py-2 rounded-lg text-sm font-semibold flex items-center justify-center gap-2 hover:bg-blue-600"><i class="fas fa-phone"></i> اتصال بالمريض للاستلام</a>
                                <button onclick="updateMedStatus('${doc.id}', 'searching')" class="w-full mt-2 bg-gray-200 text-gray-600 px-3 py-2 rounded-lg text-xs font-semibold hover:bg-gray-300">
                                    <i class="fas fa-undo"></i> تراجع عن التوفير (إعادة فتح الطلب)
                                </button>
                            `;
                        } else {
                            interactionArea = `
                                <div class="bg-gray-100 text-gray-500 text-sm font-bold p-3 rounded-lg text-center flex items-center justify-center gap-2 cursor-not-allowed">
                                    <i class="fas fa-lock"></i> تم إغلاق هذا الطلب (تم توفير الدواء من صيدلية أخرى)
                                </div>
                            `;
                        }
                    } else if (req.status === 'unavailable') {
                        interactionArea = `
                            <div class="bg-gray-100 text-gray-400 text-sm font-bold p-3 rounded-lg text-center flex items-center justify-center gap-2">
                                <i class="fas fa-times-circle"></i> قمت بإغلاق هذا الطلب كونه غير متوفر لديك
                            </div>
                            <button onclick="updateMedStatus('${doc.id}', 'searching')" class="w-full mt-2 bg-gray-200 text-gray-600 px-3 py-2 rounded-lg text-xs font-semibold hover:bg-gray-300">
                                <i class="fas fa-undo"></i> إعادة فتح الطلب (توفر لديك الآن)
                            </button>
                        `;
                    } else {
                        let actionButtons = `
                            <div class="flex gap-2 mt-2">
                                <button onclick="setMedAvailable('${doc.id}', '${pharm.name}')" class="flex-1 bg-green-500 text-white px-3 py-2 rounded-lg text-sm font-semibold hover:bg-green-600">
                                    <i class="fas fa-check"></i> توفّر الدواء
                                </button>
                                <button onclick="updateMedStatus('${doc.id}', 'unavailable')" class="flex-1 bg-gray-500 text-white px-3 py-2 rounded-lg text-sm font-semibold hover:bg-gray-600">
                                    <i class="fas fa-times"></i> غير متوفر
                                </button>
                            </div>`;
                        interactionArea = `
                            <input type="text" id="medNotes_${doc.id}" placeholder="ملاحظة للمواطن (مثال: استلمه خلال ساعة)" value="${req.notes || ''}" onblur="updateMedNotes('${doc.id}', this.value)" class="ctrl-input text-sm py-1">
                            ${actionButtons}
                            <div class="flex gap-2 mt-2">
                                <a href="tel:${phone}" class="flex-1 bg-blue-500 text-white px-3 py-2 rounded-lg text-sm font-semibold flex items-center justify-center gap-2 hover:bg-blue-600"><i class="fas fa-phone"></i> اتصال بالمريض</a>
