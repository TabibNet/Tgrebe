            </div>`; 
        } catch (err) { 
            showToast('حدث خطأ أثناء إرسال الطلب'); 
            submitBtn.disabled = false; 
            submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> إرسال للصيدليات'; 
