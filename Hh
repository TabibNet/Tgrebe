            // للصور: ننتقل بعد 6 ثوانٍ ثابتة
            if (!isSingleAd) {
                adInterval = setTimeout(nextAdSlide, 6000);
            }
            
        } else if (ad.type === 'video') {
            const loopAttr = isSingleAd ? 'loop' : '';
            const endedAttr = isSingleAd ? '' : 'onended="nextAdSlide()"';
            
            // إضافة onloadedmetadata لقراءة مدة الفيديو، و onwaiting/onplaying لإيقاف المؤقت وقت التحميل
            mediaHTML = `<div class="relative w-full h-full bg-black overflow-hidden">
                <video id="homeAdVideo" autoplay muted playsinline preload="auto" ${loopAttr} ${endedAttr} onerror="nextAdSlide()" onloadedmetadata="setupVideoFallback(this)" onwaiting="pauseAdFallback()" onplaying="resumeAdFallback(this)" class="w-full h-full object-cover">
                    <source src="${ad.content}" type="video/mp4">
                    متصفحك لا يدعم تشغيل الفيديو المباشر.
                </video>
                <button onclick="toggleAdVideoSound()" class="absolute top-3 right-3 bg-black/50 hover:bg-black/70 text-white w-9 h-9 rounded-full flex items-center justify-center backdrop-blur-sm z-30 transition-all">
                    <i class="fas fa-volume-xmark" id="adVideoSoundIcon"></i>
                </button>
            </div>`;
            
            // مؤقت احتياطي افتراضي (30 ثانية) فقط في حال فشل قراءة مدة الفيديو
            if (!isSingleAd) {
                adInterval = setTimeout(nextAdSlide, 30000);
            }
        }

        container.innerHTML = `<div class="w-full h-full transition-opacity duration-500">${mediaHTML}</div>`;
        
        if (dotsContainer) {
            if (isSingleAd) {
                dotsContainer.innerHTML = '';
