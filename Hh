    // === دوال جديدة للتحكم الذكي بوقت الفيديو ===

    // 1. عند تحميل بيانات الفيديو، نعرف مدته الحقيقية ونضبط المؤقت عليها + ثانيتين احتياط
    window.setupVideoFallback = (videoElement) => {
        if (adInterval) clearTimeout(adInterval);
        const duration = videoElement.duration;
        
        if (!isNaN(duration) && duration > 0 && activeAds.length > 1) {
            // ضبط المؤقت لينتهي مع نهاية الفيديو بالضبط (+ ثانيتين)
            adInterval = setTimeout(nextAdSlide, (duration * 1000) + 2000);
        }
    };

    // 2. إذا توقف الفيديو للتحميل (Buffering)، نوقف المؤقت لكي لا ينتقل السلايدر ويقطع الفيديو
    window.pauseAdFallback = () => {
        if (adInterval) clearTimeout(adInterval);
    };

    // 3. عندما يعود الفيديو للتشغيل، نحسب الوقت المتبقي له ونستأنف المؤقت
    window.resumeAdFallback = (videoElement) => {
        if (adInterval) clearTimeout(adInterval);
        const remainingTime = (videoElement.duration - videoElement.currentTime) * 1000;
        
        if (!isNaN(remainingTime) && remainingTime > 0 && activeAds.length > 1) {
            adInterval = setTimeout(nextAdSlide, remainingTime + 1000);
        }
    };

    // دالة التحكم بالصوت (كتم / تشغيل)
    window.toggleAdVideoSound = () => {
        const video = document.getElementById('homeAdVideo');
        const icon = document.getElementById('adVideoSoundIcon');
        if (!video) return;
        
        video.muted = !video.muted;
        if (video.muted) {
            icon.className = 'fas fa-volume-xmark';
        } else {
            icon.className = 'fas fa-volume-high';
        }
    };

    window.nextAdSlide = () => {
        if (activeAds.length === 0) return;
        currentAdIndex = (currentAdIndex + 1) % activeAds.length;
        renderAdSlide(currentAdIndex);
    }

    window.prevAdSlide = () => {
        if (activeAds.length === 0) return;
        currentAdIndex = (currentAdIndex - 1 + activeAds.length) % activeAds.length;
        renderAdSlide(currentAdIndex);
    }

    window.goToAdSlide = (index) => {
        currentAdIndex = index;
        renderAdSlide(currentAdIndex);
    }

                  // === 1. عرض الإعلانات المحفوظة محلياً فوراً (0 قراءة) ===
        const cachedAds = localStorage.getItem('cached_home_ads');
        if (cachedAds) {
            activeAds = JSON.parse(cachedAds);
            const section = document.getElementById('homeMediaAdsSection');
            if (activeAds.length === 0) {
                section.classList.add('hidden');
            } else {
                section.classList.remove('hidden');
                currentAdIndex = 0;
                renderAdSlide(currentAdIndex);
            }
        }

        // === 2. التحقق من رقم الإصدار من Firebase (1 قراءة فقط) ===
        const adsConfigRef = doc(db, 'app_config', 'ads_sync');
        getDoc(adsConfigRef).then(async (docSnap) => {
            let serverTime = 0;
            
            if (!docSnap.exists()) {
                // إنشاء مستند الإصدار لأول مرة
                await setDoc(adsConfigRef, { lastUpdate: Date.now() });
                serverTime = Date.now();
            } else {
                serverTime = docSnap.data().lastUpdate;
            }

            const localTime = parseInt(localStorage.getItem('ads_last_fetch') || '0');

            // === 3. إذا تم تعديل الإعلان من لوحة الإدارة، نقوم بجلب الإعلانات الجديدة ===
            if (serverTime > localTime) {
                const adsQuery = query(collection(db, 'homepage_ads'), where('isActive', '==', true), limit(5));
                const snapshot = await getDocs(adsQuery);
                
                activeAds = [];
                snapshot.forEach(d => activeAds.push({ id: d.id, ...d.data() }));
                
                const section = document.getElementById('homeMediaAdsSection');
                if (activeAds.length === 0) {
                    section.classList.add('hidden');
                    if (adInterval) clearInterval(adInterval);
                } else {
                    section.classList.remove('hidden');
                    currentAdIndex = 0;
                    renderAdSlide(currentAdIndex);
                }

                // حفظ الإعلانات الجديدة محلياً وتحديث وقت الحفظ
                try {
                    localStorage.setItem('cached_home_ads', JSON.stringify(activeAds));
                    localStorage.setItem('ads_last_fetch', serverTime.toString());
                } catch(e) {}
            }
            
            const ctrlTitle = document.getElementById('ctrlTitle')?.textContent || '';
            if (ctrlTitle === 'لوحة الإدارة') fetchHomeAdsForAdmin();
        });

    let allHomeAds = [];
    async function fetchHomeAdsForAdmin() {
        const snap = await getDocs(collection(db, 'homepage_ads'));
        allHomeAds = [];
        snap.forEach(doc => allHomeAds.push({ id: doc.id, ...doc.data() }));
        renderHomeAdsList();
    }

    function renderHomeAdsList() {
        const list = document.getElementById('adminHomeAdsList');
        if (!list) return;
        if (allHomeAds.length === 0) {
            list.innerHTML = '<p class="text-center text-gray-400 text-sm py-2">لا توجد إعلانات حالياً.</p>';
            return;
        }
        list.innerHTML = allHomeAds.map(ad => `
            <div class="flex items-center justify-between p-2 rounded-lg border" style="border-color: var(--border)">
                <div class="text-xs truncate flex-1 flex items-center gap-2">
                    <i class="fas ${ad.type === 'image' ? 'fa-image text-blue-500' : 'fa-video text-purple-500'}"></i>
                    <span class="truncate">${ad.content.substring(0, 30)}...</span>
                </div>
                <div class="flex gap-1 mr-2">
                    <button onclick="toggleHomeAdStatus('${ad.id}', ${!ad.isActive})" class="px-2 py-1 rounded text-xs ${ad.isActive ? 'bg-green-500 text-white' : 'bg-gray-200'}">${ad.isActive ? 'مفعّل' : 'معطّل'}</button>
                    <button onclick="deleteHomeAd('${ad.id}')" class="px-2 py-1 rounded text-xs bg-red-500 text-white"><i class="fas fa-trash"></i></button>
                </div>
            </div>
        `).join('');
    }

    window.saveHomeAd = async (e) => {
        e.preventDefault();
        const type = document.getElementById('adType').value;
        const content = document.getElementById('adContent').value.trim();
        const link = document.getElementById('adLink').value.trim();
        if (!content) { showToast('الرجاء إدخال رابط الصورة أو الفيديو'); return; }
        
        // تنبيه المستخدم إذا أدخل رابط يوتيوب بالخطأ
        if (type === 'video' && (content.includes('youtube.com') || content.includes('youtu.be'))) {
            showToast('تنبيه: يتم دعم روابط الفيديو المباشرة (MP4) فقط، روابط يوتيوب لن تعمل.');
        }

        try {
            await addDoc(collection(db, 'homepage_ads'), {
                type, content, link, 
                isActive: document.getElementById('adActiveCheck').checked, 
                createdAt: new Date().toISOString()
            });
            // تحديث وقت آخر تعديل ليعرف الموقع أنه يوجد إعلان جديد
await setDoc(doc(db, 'app_config', 'ads_sync'), { lastUpdate: Date.now() });
            showToast('تم حفظ الإعلان بنجاح!');
            e.target.reset();
            fetchHomeAdsForAdmin();
        } catch (err) { showToast('خطأ في حفظ الإعلان'); }
    };

    window.toggleHomeAdStatus = async (id, status) => {
        try {
            await updateDoc(doc(db, 'homepage_ads', id), { isActive: status });
            // تحديث وقت آخر تعديل ليعرف الموقع أنه يوجد إعلان جديد
await setDoc(doc(db, 'app_config', 'ads_sync'), { lastUpdate: Date.now() });
            showToast('تم تحديث حالة الإعلان');
            fetchHomeAdsForAdmin();
        } catch (err) { showToast('خطأ في التحديث'); }
    };

    window.deleteHomeAd = async (id) => {
        try {
            await deleteDoc(doc(db, 'homepage_ads', id));
            // تحديث وقت آخر تعديل ليعرف الموقع أنه يوجد إعلان جديد
await setDoc(doc(db, 'app_config', 'ads_sync'), { lastUpdate: Date.now() });
            showToast('تم حذف الإعلان');
            fetchHomeAdsForAdmin();
        } catch (err) { showToast('خطأ في الحذف'); }
    };
                    // دالة للتحقق إذا كانت كل المربعات فارغة لإخفاء القسم بالكامل
    function checkAlertsWrapperVisibility() {
        const wrapper = document.getElementById('homeAlertsWrapper');
        const bloodSection = document.getElementById('homeBloodAlertsSection');
        const medSection = document.getElementById('homeMedicinesSection');
        
        if (bloodSection.classList.contains('hidden') && medSection.classList.contains('hidden')) {
            wrapper.classList.add('hidden');
            wrapper.classList.remove('flex');
        } else {
            wrapper.classList.remove('hidden');
            wrapper.classList.add('flex');
        }
    }
                    // تسجيل Service Worker مع تفعيل التحديث التلقائي الفوري
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
            navigator.serviceWorker.register('sw.js')
                .then(reg => {
                    console.log('✅ SW registered successfully:', reg.scope);
                    
                    // إجبار المتصفح على البحث عن تحديثات جديدة في كل مرة يفتح فيها الموقع
                    reg.addEventListener('updatefound', () => {
                        const newWorker = reg.installing;
                        newWorker.addEventListener('statechange', () => {
                            if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                                // يوجد تحديث جديد! أرسل أمر لتفعيله فوراً
                                newWorker.postMessage({ type: 'SKIP_WAITING' });
                            }
                        });
                    });
                })
                .catch(err => console.error('❌ SW registration failed:', err));
        });

        // الاستماع لرسالة التحديث وتحديث الصفحة تلقائياً ليظهر التعديل الجديد
        let refreshing;
        navigator.serviceWorker.addEventListener('controllerchange', () => {
            if (refreshing) return;
            window.location.reload();
            refreshing = true;
        });
    }

    // التقاط حدث تثبيت التطبيق ( لإظهار زر مخصص إذا أردت لاحقاً )
    let deferredPrompt;
    window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        console.log('⚡ التطبيق قابل للتثبيت الآن!');
    });
    
</script>
