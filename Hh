                dotsContainer.innerHTML = activeAds.map((_, i) => `
                    <span class="w-2 h-2 rounded-full bg-white/50 cursor-pointer transition-all ${i === index ? 'w-6 bg-white' : ''}" onclick="goToAdSlide(${i})"></span>
                `).join('');
